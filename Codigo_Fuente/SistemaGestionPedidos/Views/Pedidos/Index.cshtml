@model List<Pedido>
@{
    ViewData["Title"] = "Pedidos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Pedidos</h1>
    <a asp-action="Create" class="btn btn-success">+ Nuevo pedido</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Total</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@(p.Cliente?.Nombre ?? "-")</td>
            <td>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
            <td><span class="badge badge-estado-@p.Estado">@p.Estado</span></td>
            <td>@p.Total.ToString("C")</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center">No hay pedidos registrados todavía.</p>
}
