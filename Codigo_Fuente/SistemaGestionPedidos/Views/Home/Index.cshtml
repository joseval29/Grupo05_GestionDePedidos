@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-5">
    <h1 class="display-6">Sistema de Gestión de Pedidos</h1>
    <p class="text-muted">Arquitectura Monolítica &mdash; .NET MVC + C# + Entity Framework Core + SQL Server</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card text-center p-4">
            <h2 class="display-5">@ViewBag.TotalClientes</h2>
            <p class="text-muted mb-3">Clientes registrados</p>
            <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-primary">Ver clientes</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-4">
            <h2 class="display-5">@ViewBag.TotalProductos</h2>
            <p class="text-muted mb-3">Productos en catálogo</p>
            <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary">Ver productos</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-4">
            <h2 class="display-5">@ViewBag.TotalPedidos</h2>
            <p class="text-muted mb-3">Pedidos realizados</p>
            <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-primary">Ver pedidos</a>
        </div>
    </div>
</div>

<div class="text-center mt-5">
    <a asp-controller="Pedidos" asp-action="Create" class="btn btn-success btn-lg">+ Crear nuevo pedido</a>
</div>
