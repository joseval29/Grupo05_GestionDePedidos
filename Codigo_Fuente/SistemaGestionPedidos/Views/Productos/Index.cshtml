@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Productos</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo producto</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Stock</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Nombre</td>
            <td>@(p.Descripcion ?? "-")</td>
            <td>@p.Precio.ToString("C")</td>
            <td>
                @if (p.Stock <= 5)
                {
                    <span class="badge bg-warning text-dark">@p.Stock (bajo)</span>
                }
                else
                {
                    @p.Stock
                }
            </td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center">No hay productos registrados todavía.</p>
}
